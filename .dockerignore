# ── never into an image ─────────────────────────────────────────────────────
# The real statements. They are gitignored too; an image is just another way to
# hand them to someone.
samples/

# Secrets. .env.example files are the only ones that travel.
**/.env
**/.env.*
!**/.env.example

# ── not needed to build or run ──────────────────────────────────────────────
**/node_modules/
**/dist/
**/coverage/
.git/
.github/
.vscode/
.idea/
docs/
**/*.md

# Tests and their fixtures stay out of the image.
backend/test/
backend/fixtures/
frontend/test/
shared/test/

# OS noise
.DS_Store
Thumbs.db
