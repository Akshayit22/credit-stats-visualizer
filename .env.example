# ════════════════════════════════════════════════════════════════════════════
#  cred-stats — copy to .env.local and fill in. SETUP.md says where each value
#  comes from. Nothing here is needed for the demo path:
#      npm run db:up && npm run db:create && npm run db:seed && npm run dev:nollm
# ════════════════════════════════════════════════════════════════════════════

# ── app ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=

# Signs in a fixed demo user with no Google credentials. Ignored in production.
CRED_STATS_DEV_LOGIN=true

# ── Google sign-in (SETUP.md §2) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── DynamoDB ────────────────────────────────────────────────────────────────
# Local: DynamoDB Local in Docker. Leave DDB_ENDPOINT unset in the cloud so the
# SDK uses its default resolver and the instance IAM role.
DDB_ENDPOINT=http://localhost:8000
DDB_TABLE_PREFIX=cred-stats-local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ── AI provider ─────────────────────────────────────────────────────────────
# One of: mock | azure-foundry | bedrock | groq | openai-compatible
LLM_PROVIDER=mock

# azure-foundry
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=
AZURE_AI_API_VERSION=2024-10-21

# bedrock — credentials come from the standard AWS chain or the keys above.
# Careful: AWS_ACCESS_KEY_ID=local above is in that same chain. Use a named AWS
# profile, or real keys, if you point this at Bedrock while developing locally.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# openai-compatible — xAI Grok, OpenAI, OpenRouter, Ollama, …
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
