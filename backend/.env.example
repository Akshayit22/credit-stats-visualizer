# ════════════════════════════════════════════════════════════════════════════
#  cred-stats API — copy to backend/.env for local development.
#  docs/setup.md says where each value comes from. The defaults below are the
#  local ones: `npm run db:up` starts the MongoDB this points at.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# The built frontend, when this process should serve it too (the Docker image
# sets it). Leave it commented out locally: Vite serves the app on :5173.
# CRED_STATS_WEB_DIR=../frontend/dist

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local: the container from docker-compose.yml. Production: the Atlas SRV
# string, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cred-stats

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Signs the session cookie: `openssl rand -base64 32`. Required in production.
# Left blank locally, a random one is made each time the API starts.
CRED_STATS_SESSION_SECRET=

# The OAuth client id for Sign in with Google (docs/setup.md). No client
# secret is needed: the browser gets an ID token and the API verifies it.
GOOGLE_CLIENT_ID=

# Offers a "Demo user" sign-in that needs no Google account. Always refused
# when NODE_ENV=production.
CRED_STATS_DEV_LOGIN=true

# ── AI provider ─────────────────────────────────────────────────────────────
# One of: mock | groq | azure-foundry | openai-compatible
# Only used for a bank no built-in parser covers, or a merchant no rule
# matches. `mock` calls no model at all.
LLM_PROVIDER=mock

# groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# azure-foundry — the resource endpoint, a key, and the deployment name
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=
AZURE_AI_API_VERSION=2024-10-21

# openai-compatible — xAI Grok, OpenAI, OpenRouter, a local Ollama, …
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
