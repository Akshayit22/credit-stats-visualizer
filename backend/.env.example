# ════════════════════════════════════════════════════════════════════════════
#  cred-stats API — copy to backend/.env for local development.
#  docs/setup.md says where each value comes from. The defaults below are the
#  local ones: `npm run db:up` starts the MongoDB this points at.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Local: the container from docker-compose.yml. Production: the Atlas SRV
# string, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cred-stats

# ── AI provider ─────────────────────────────────────────────────────────────
# One of: mock | groq | azure-foundry | openai-compatible
LLM_PROVIDER=mock
