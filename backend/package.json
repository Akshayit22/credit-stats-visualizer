{
  "name": "@cred-stats/backend",
  "version": "2.0.0",
  "description": "The cred-stats API: NestJS on MongoDB.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently --kill-others --names tsc,api --prefix-colors blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --env-file-if-exists=.env dist/scripts/seed-demo.js",
    "fixtures:build": "node dist/scripts/build-fixtures.js"
  },
  "dependencies": {
    "@cred-stats/shared": "*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.3.0",
    "pdfjs-dist": "^6.3.289",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0"
  }
}
